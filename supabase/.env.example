# Supabase Edge Function secrets. Copy to supabase/.env (gitignored), then push:
#   supabase secrets set --env-file supabase/.env
#
# NOTE: SUPABASE_SERVICE_ROLE_KEY and SUPABASE_URL are auto-injected into Edge
# Functions by the platform. Do NOT set them here — Supabase rejects any secret
# name beginning with SUPABASE_.

# ── Clerk ──────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://special-buzzard-45.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=whsec_...

# ── Bunny.net Stream ───────────────────────────────────────────────────────
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_CDN_HOSTNAME=vz-xxxxxxxx-xxx.b-cdn.net
BUNNY_PULLZONE_SECURITY_KEY=
BUNNY_ACCOUNT_API_KEY=

# ── App ────────────────────────────────────────────────────────────────────
# The production origin. NEVER "*" — see CLAUDE.md trap #9.
ALLOWED_ORIGIN=http://localhost:3000
# Optional: restricts who may claim the first administrator via setup-admin.mjs
BOOTSTRAP_ADMIN_EMAILS=jonathan@startlands.com

# Rewarded-ad test rail (ads-ssv): both this secret AND ad_test_mode=true are required
ADS_TEST_SECRET=
# Optional: override the Google SSV verifier-keys URL (tests only)
# SSV_KEYS_URL=
